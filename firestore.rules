rules_version = '2';

// 작년 앱은 권한 확인을 앱 화면에서만 했다. 여기서는 서버(Firestore)가 직접 막는다.
// 역할: users/{uid}.role 이 'admin' 또는 'staff'. 일반 사용자는 role 필드가 없다.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function myRole() {
      return signedIn() && exists(userPath()) ? get(userPath()).data.get('role', '') : '';
    }
    function isStaff() { return myRole() in ['staff', 'admin']; }
    function isAdmin() { return myRole() == 'admin'; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // 사용자 정보: 본인과 관리자만 읽는다. role 은 관리자만 바꿀 수 있다.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid && !('role' in request.resource.data);
      allow update: if signedIn() && (
        (request.auth.uid == uid && !changed().hasAny(['role'])) ||
        (isAdmin() && request.auth.uid != uid && changed().hasOnly(['role'])
          && request.resource.data.get('role', '') in ['', 'staff', 'admin'])
      );
      allow delete: if false;
    }

    // 메뉴: 누구나 읽고, 스태프만 고친다
    match /menu/{id} {
      allow read: if true;
      allow write: if isStaff();
    }

    // 주문 받기 스위치와 공지
    match /meta/settings {
      allow read: if true;
      allow write: if isStaff();
    }

    // 주문 번호 카운터: 1씩만 올릴 수 있다
    match /meta/counter {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.n == 1;
      allow update: if signedIn() && request.resource.data.n == resource.data.n + 1;
    }

    match /orders/{id} {
      // 본인 주문과 스태프만 읽는다 (작년 앱은 이 구분이 화면에만 있었다)
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isStaff());

      // 본인 이름으로, '접수됨' 상태로만 만들 수 있다
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paid == false
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.student is string
        && request.resource.data.student.size() <= 60
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 60
        && request.resource.data.note.size() <= 300;

      // 스태프는 상태와 입금 확인을 바꾼다. 주문자는 '접수됨'일 때만 취소할 수 있다.
      allow update: if isStaff() && changed().hasOnly(['status', 'paid', 'updatedAt'])
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && changed().hasOnly(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }
  }
}
